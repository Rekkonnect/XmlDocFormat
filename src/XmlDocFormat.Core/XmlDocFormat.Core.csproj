<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Garyon" Version="0.4.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.0.0" />
    <PackageReference Include="Vogen" Version="8.0.4" />
    <PackageReference Include="System.IO.Abstractions" Version="22.1.0" />
    <PackageReference
      Include="XmlDocFormat.InternalGenerators"
      Version="$(InternalGeneratorsVersion)"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
    Not directly usable; just an explicit reference to force this
    project be built after the generators project is packaged
    -->
    <ProjectReference
      Include="..\..\tools\XmlDocFormat.InternalGenerators\XmlDocFormat.InternalGenerators.csproj"
      PrivateAssets="all"
      ReferenceOutputAssembly="false" />

    <ProjectReference Include="..\..\tools\XmlDocFormat.InternalGenerators.Core\XmlDocFormat.InternalGenerators.Core.csproj" />
  </ItemGroup>

</Project>
