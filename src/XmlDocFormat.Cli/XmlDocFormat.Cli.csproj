<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Tool Package">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>XmlDocFormat</ToolCommandName>

    <PackageOutputPath>../../artifacts/</PackageOutputPath>

    <PackageId>XmlDocFormat.Cli</PackageId>
    <Description>CLI tool for XML documentation formatting</Description>
    <Copyright>© 2026 Rekkonnect</Copyright>
    <Authors>Rekkonnect</Authors>

    <Version>1.0.2</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>xmldoc, xml, documentation, csharp, format, cli, tool</PackageTags>

    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/Rekkonnect/XmlDocFormat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Rekkonnect/XmlDocFormat</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="D20Tek.Spectre.Console.Extensions" Version="1.54.2" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
    <PackageReference Include="UTF.Unknown" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XmlDocFormat.Core\XmlDocFormat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\DotnetToolSettings.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\packspec.nuspec">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
